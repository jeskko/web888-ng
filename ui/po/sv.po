#. about = where the time-code station is and how its time signal is keyed (carrier reduced/off for 0.1-0.8 s per second: a 0 or 1 bit, a marker)
#: src/timecode.ts:28
msgid "Mainflingen, Germany: carrier reduced 0.1 s (0) or 0.2 s (1) each second, none at second 59; CET/CEST"
msgstr "Mainflingen, Tyskland: bärvågen sänkt 0,1 s (0) eller 0,2 s (1) varje sekund, ingen vid sekund 59; CET/CEST"

#: src/timecode.ts:29
msgid "Anthorn, UK: carrier off 0.1 s, then bits A and B; 0.5 s at the minute; GMT/BST"
msgstr "Anthorn, Storbritannien: bärvågen av 0,1 s, sedan bitarna A och B; 0,5 s vid minutskiftet; GMT/BST"

#: src/timecode.ts:30
msgid "Fort Collins, USA: carrier reduced 0.2 s (0), 0.5 s (1), 0.8 s (marker); UTC"
msgstr "Fort Collins, USA: bärvågen sänkt 0,2 s (0), 0,5 s (1), 0,8 s (markör); UTC"

#: src/timecode.ts:31
msgid "Japan: carrier on 0.8 s (0), 0.5 s (1), 0.2 s (marker); JST"
msgstr "Japan: bärvågen på 0,8 s (0), 0,5 s (1), 0,2 s (markör); JST"

#: src/timecode.ts:32
msgid "Taldom near Moscow: each 0.1 s a bit, the carrier phase-modulated at 100 Hz (0) or 312.5 Hz (1); Moscow time"
msgstr "Taldom nära Moskva: en bit var 0,1 s, bärvågen fasmodulerad med 100 Hz (0) eller 312,5 Hz (1); Moskvatid"

#: src/timecode.ts:33
msgid "Fort Collins and Hawaii: the 100 Hz subcarrier 0.17 s (0), 0.47 s (1), 0.77 s (marker), heard in AM; UTC"
msgstr "Fort Collins och Hawaii: underbärvågen på 100 Hz 0,17 s (0), 0,47 s (1), 0,77 s (markör), hörs i AM; UTC"

#: src/timecode.ts:76
msgid "no station {name}"
msgstr "ingen station {name}"

#. AM, USB, LSB, CW are mode names (kept in English); a station's carrier is its unmodulated radio frequency
#: src/timecode.ts:80
msgid "{name}: tune AM to {mhz} MHz"
msgstr "{name}: ställ in AM på {mhz} MHz"

#: src/timecode.ts:81
msgid "{name}: tune its carrier ({khz} kHz) into the passband in USB, LSB or CW"
msgstr "{name}: ställ in dess bärvåg ({khz} kHz) i passbandet i USB, LSB eller CW"

#: src/timecode.ts:84
msgid "No time station in the passband: pick one to tune to."
msgstr "Ingen tidssignalstation i passbandet: välj en att ställa in."

