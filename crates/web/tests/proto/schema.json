{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "radio": {
      "description": "The radio hardware (changes need a restart).",
      "$ref": "#/$defs/Radio",
      "default": {
        "backend": "zynqsdr",
        "bitstream": "auto",
        "si5351_adc": null,
        "sim": {
          "tones": [],
          "noise": false
        },
        "iq": {
          "source": null,
          "freq": null,
          "rate": 7680000.0,
          "gains": {},
          "bandwidth": 0.0,
          "antenna": null,
          "loop": false
        }
      }
    },
    "hpsdr": {
      "description": "HPSDR Protocol 1 server (changes need a restart).",
      "$ref": "#/$defs/Hpsdr",
      "default": {
        "enabled": true,
        "listen": "0.0.0.0:1024",
        "board": 1,
        "receivers": 7
      }
    },
    "web": {
      "description": "Web UI server.",
      "$ref": "#/$defs/Web",
      "default": {
        "enabled": true,
        "listen": "0.0.0.0:8073",
        "ui_dir": "/usr/share/web888d/ui",
        "tls": "self-signed",
        "tls_cert": null,
        "tls_key": null,
        "state_dir": "/var/lib/web888d",
        "default_freq": null,
        "wf_budget": 30,
        "metrics": false,
        "trusted_proxies": []
      }
    },
    "limits": {
      "description": "Sessions and channel sharing (apply at once).",
      "$ref": "#/$defs/Limits",
      "default": {
        "per_ip": 4,
        "session_minutes": 0,
        "idle_minutes": 0,
        "preempt": false,
        "hpsdr_channels": 7,
        "share_default": true,
        "skimmers_yield": true
      }
    },
    "station": {
      "description": "The station, as reported with spots (apply at once).",
      "$ref": "#/$defs/Station",
      "default": {
        "callsign": "",
        "locator": "",
        "antenna": "",
        "gpsd": ""
      }
    },
    "skimmer": {
      "description": "Background decoders (`doc/m4-skimmers.md`; apply at once).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Skimmer"
      },
      "default": []
    },
    "report": {
      "description": "Where spots go (apply at once).",
      "$ref": "#/$defs/Report",
      "default": {
        "pskreporter": false,
        "pskreporter_server": "report.pskreporter.info:4739",
        "wsprnet": false,
        "wsprnet_url": "http://wsprnet.org/post"
      }
    },
    "syslog": {
      "description": "The skimmers' log (spots, band and upload events) to a syslog\nreceiver (apply at once).",
      "$ref": "#/$defs/Syslog",
      "default": {
        "server": "",
        "transport": "udp",
        "format": "rfc5424",
        "facility": "local0",
        "events": [
          "spot",
          "band",
          "upload"
        ],
        "modes": [],
        "hostname": ""
      }
    },
    "mqtt": {
      "description": "The same to an MQTT broker (apply at once).",
      "$ref": "#/$defs/Mqtt",
      "default": {
        "server": "",
        "username": "",
        "password": "",
        "client_id": "",
        "topic": "",
        "events": [
          "spot",
          "band",
          "upload"
        ],
        "modes": []
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Radio": {
      "type": "object",
      "properties": {
        "backend": {
          "description": "Where the samples come from.",
          "$ref": "#/$defs/Backend",
          "default": "zynqsdr"
        },
        "bitstream": {
          "description": "zynqsdr: a path, `auto` (the image's or the stock one) or `none`.",
          "type": "string",
          "default": "auto"
        },
        "si5351_adc": {
          "description": "EXPERIMENTAL (test unit only): reprogram the Si5351 ADC clock (Hz).",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "sim": {
          "description": "Backend sim: the simulated scene.",
          "$ref": "#/$defs/Sim",
          "default": {
            "tones": [],
            "noise": false
          }
        },
        "iq": {
          "description": "Backend iq: the wideband IQ input.",
          "$ref": "#/$defs/Iq",
          "default": {
            "source": null,
            "freq": null,
            "rate": 7680000.0,
            "gains": {},
            "bandwidth": 0.0,
            "antenna": null,
            "loop": false
          }
        }
      },
      "additionalProperties": false
    },
    "Backend": {
      "oneOf": [
        {
          "description": "Simulated radio (real time).",
          "type": "string",
          "const": "sim"
        },
        {
          "description": "Kernel driver `/dev/zynqsdr` (stock or open).",
          "type": "string",
          "const": "zynqsdr"
        },
        {
          "description": "Wideband IQ from an SDR or a recording, channelized like the FPGA.",
          "type": "string",
          "const": "iq"
        }
      ]
    },
    "Sim": {
      "type": "object",
      "properties": {
        "tones": {
          "description": "Tones at the antenna: [frequency Hz, level dBFS].",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "default": []
        },
        "noise": {
          "description": "Add the typical ADC noise floor.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Iq": {
      "type": "object",
      "properties": {
        "source": {
          "description": "`file:PATH` (.cs8/.cs16/.cf32) or `soapy:ARGS`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "freq": {
          "description": "Input centre frequency (Hz).",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "rate": {
          "description": "Input sample rate: 122.88 MHz / 8, 16, ..., 256.",
          "type": "number",
          "format": "double",
          "default": 7680000.0
        },
        "gains": {
          "description": "Device gain elements (soapy), dB.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        },
        "bandwidth": {
          "description": "Device analog bandwidth (Hz, 0 = the driver's choice).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "antenna": {
          "description": "Device antenna port (soapy).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "loop": {
          "description": "Start a file again at its end.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Hpsdr": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listen": {
          "description": "UDP listen address.",
          "type": "string",
          "default": "0.0.0.0:1024"
        },
        "board": {
          "description": "Board id reported to clients (1 = Hermes, 5 = Orion, 6 = Hermes-Lite).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 1
        },
        "receivers": {
          "description": "Receivers offered (max 7).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 7
        }
      },
      "additionalProperties": false
    },
    "Web": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listen": {
          "description": "HTTPS and plain HTTP on one port.",
          "type": "string",
          "default": "0.0.0.0:8073"
        },
        "ui_dir": {
          "description": "The web UI's files.",
          "type": "string",
          "default": "/usr/share/web888d/ui"
        },
        "tls": {
          "$ref": "#/$defs/TlsMode",
          "default": "self-signed"
        },
        "tls_cert": {
          "description": "tls = files: the certificate (PEM).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tls_key": {
          "description": "tls = files: the private key (PEM).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "state_dir": {
          "description": "Where web888d keeps state (the self-signed certificate).",
          "type": "string",
          "default": "/var/lib/web888d"
        },
        "default_freq": {
          "description": "Initial dial frequency (Hz; default 7.074 MHz if in range).",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "wf_budget": {
          "description": "Most FFTs averaged per waterfall line (CPU budget; default 30, 6 on\n32-bit ARM, where an FFT costs ~100x more: `doc/m3-multi-user.md` §4).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 30
        },
        "metrics": {
          "description": "Serve Prometheus metrics at `/metrics` (no login).",
          "type": "boolean",
          "default": false
        },
        "trusted_proxies": {
          "description": "Reverse proxies (addresses or networks, e.g. \"10.0.0.5\",\n\"192.168.0.0/16\") whose X-Forwarded-For and X-Forwarded-Proto are\nbelieved: for requests from them, the client is the rightmost\nforwarded address that isn't a trusted proxy itself.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "TlsMode": {
      "oneOf": [
        {
          "description": "A self-signed certificate, kept in `state_dir`.",
          "type": "string",
          "const": "self-signed"
        },
        {
          "description": "`cert` and `key` (PEM).",
          "type": "string",
          "const": "files"
        },
        {
          "description": "Plain HTTP only (behind a TLS-terminating proxy).",
          "type": "string",
          "const": "off"
        }
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "per_ip": {
          "description": "Sessions per client address (0 = no limit).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 4
        },
        "session_minutes": {
          "description": "Web session time limit, minutes (0 = none). Admins aren't\nlimited; users get a notice a minute before, and reconnect by hand.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "idle_minutes": {
          "description": "Idle limit, minutes without input (tuning, mode, waterfall or\naudio changes; 0 = none). As `session_minutes` otherwise.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "preempt": {
          "description": "Higher classes may take channels from lower ones.",
          "type": "boolean",
          "default": false
        },
        "hpsdr_channels": {
          "description": "Most RX channels HPSDR clients may hold.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 7
        },
        "share_default": {
          "description": "Show users' frequencies to others and allow listen-along, unless\nthe user opts out.",
          "type": "boolean",
          "default": true
        },
        "skimmers_yield": {
          "description": "Skimmers give their channels to users when none is free, and get\none again when a channel frees.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Station": {
      "type": "object",
      "properties": {
        "callsign": {
          "description": "Callsign spots are reported under (needed for uploads).",
          "type": "string",
          "default": ""
        },
        "locator": {
          "description": "Maidenhead locator, 4 or 6 characters (needed for uploads; with\ngpsd, used until there is a fix).",
          "type": "string",
          "default": ""
        },
        "antenna": {
          "description": "Antenna, as shown on PSKReporter.",
          "type": "string",
          "default": ""
        },
        "gpsd": {
          "description": "gpsd to take the locator from, `host` or `host:port` (port 2947),\ne.g. `127.0.0.1`; empty: off.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "Skimmer": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/SkimMode",
          "default": "ft8"
        },
        "dial": {
          "description": "Dial frequency (Hz, USB), e.g. 7074000.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "hours": {
          "description": "UTC hours to run, e.g. \"18-06\" or \"0-24\"; empty = always.",
          "type": "string",
          "default": ""
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "SkimMode": {
      "type": "string",
      "enum": [
        "ft8",
        "ft4",
        "wspr"
      ]
    },
    "Report": {
      "type": "object",
      "properties": {
        "pskreporter": {
          "description": "Upload spots to PSKReporter (needs [station] callsign and locator;\nlive signals only).",
          "type": "boolean",
          "default": false
        },
        "pskreporter_server": {
          "description": "PSKReporter's address (their test listener: pskreporter.info:14739).",
          "type": "string",
          "default": "report.pskreporter.info:4739"
        },
        "wsprnet": {
          "description": "Upload WSPR spots to WSPRnet (needs [station] callsign and locator;\nlive signals only).",
          "type": "boolean",
          "default": false
        },
        "wsprnet_url": {
          "description": "WSPRnet's spot URL.",
          "type": "string",
          "default": "http://wsprnet.org/post"
        }
      },
      "additionalProperties": false
    },
    "Syslog": {
      "type": "object",
      "properties": {
        "server": {
          "description": "The receiver, `host` or `host:port` (port 514; IPv6 in brackets,\n`[2001:db8::1]:514`); empty: off.",
          "type": "string",
          "default": ""
        },
        "transport": {
          "$ref": "#/$defs/SyslogTransport",
          "default": "udp"
        },
        "format": {
          "$ref": "#/$defs/SyslogFormat",
          "default": "rfc5424"
        },
        "facility": {
          "description": "kern, user, daemon, local0 ... local7.",
          "type": "string",
          "default": "local0"
        },
        "events": {
          "description": "What to send.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogEvent"
          },
          "default": [
            "spot",
            "band",
            "upload"
          ]
        },
        "modes": {
          "description": "Spots of these modes only; empty: all.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkimMode"
          },
          "default": []
        },
        "hostname": {
          "description": "The host name in messages; empty: the system's.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "SyslogTransport": {
      "type": "string",
      "enum": [
        "udp",
        "tcp"
      ]
    },
    "SyslogFormat": {
      "oneOf": [
        {
          "description": "RFC 5424 (`<134>1 2026-10-24T21:11:45.000Z host web888d - spot - ...`).",
          "type": "string",
          "const": "rfc5424"
        },
        {
          "description": "The older BSD format, RFC 3164 (`<134>Oct 24 21:11:45 host web888d: ...`).",
          "type": "string",
          "const": "rfc3164"
        }
      ]
    },
    "LogEvent": {
      "description": "What the skimmers log, for choosing what goes to syslog and MQTT.",
      "oneOf": [
        {
          "description": "Each decoded spot.",
          "type": "string",
          "const": "spot"
        },
        {
          "description": "Bands starting and stopping, their problems, and the station's\nlocator from gpsd.",
          "type": "string",
          "const": "band"
        },
        {
          "description": "What the uploaders (PSKReporter, WSPRnet) did, and their errors.",
          "type": "string",
          "const": "upload"
        }
      ]
    },
    "Mqtt": {
      "type": "object",
      "properties": {
        "server": {
          "description": "The broker, `host` or `host:port` (port 1883; IPv6 in brackets);\nempty: off.",
          "type": "string",
          "default": ""
        },
        "username": {
          "type": "string",
          "default": ""
        },
        "password": {
          "type": "string",
          "default": ""
        },
        "client_id": {
          "description": "Client id; empty: `web888-<host name>`.",
          "type": "string",
          "default": ""
        },
        "topic": {
          "description": "Topics start with this; empty: `web888/<host name>`. Spots go to\n`<topic>/spot/<MODE>`, events to `<topic>/band` and\n`<topic>/upload`, and `<topic>/status` is `online` (retained;\n`offline` as the broker's last will).",
          "type": "string",
          "default": ""
        },
        "events": {
          "description": "What to publish.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogEvent"
          },
          "default": [
            "spot",
            "band",
            "upload"
          ]
        },
        "modes": {
          "description": "Spots of these modes only; empty: all.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkimMode"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
